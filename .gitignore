# ABI-SNP Analyzer v1.1.2 — Git ignore rules
# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
ENV/
env/

# PyInstaller build artifacts
build/
dist/
*.spec.bak

# Executables and large binaries (distributed via GitHub Releases, not source control)
*.exe
*.msi
bin/*.exe

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
~$*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Test / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
pytest-cache-files-*/
.ipynb_checkpoints/

# Environment
.env
.env.local

# Runtime output (generated per run)
output/
*.xlsx
*.csv
!example/genotype_matrix-2.xlsx

# Regenerated analysis outputs inside example/ (only .ab1 inputs are tracked)
example/**/*.png
example/**/*.fasta
example/**/*.aln
example/**/*.json

# Large reference genomes / external tool binaries
genome/
*.fna
*.fasta
*.fa
ncbi-blast-*/
muscle*.exe
blastn*.exe

# Work in progress
~*
